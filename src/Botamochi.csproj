<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Optimize>true</Optimize>
    <!-- .NET 10 Tiered PGO & Native AOT コンパイル最適化 -->
    <TieredPGO>true</TieredPGO>
    <OptimizationPreference>Speed</OptimizationPreference>
    <DefineConstants Condition="'$(Configuration)' == 'Debug' Or '$(RenderStats)' == 'true'">$(DefineConstants);RENDER_STATS</DefineConstants>
    <PublishTrimmed Condition="'$(PublishAot)' != 'true'">false</PublishTrimmed>
    <IlcPgoOptimize>true</IlcPgoOptimize>
    <NoWarn>CA1416;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(PgoProfile)' != ''">
    <MibcFile Include="$(PgoProfile)" />
  </ItemGroup>
  <ItemGroup Condition="'$(WaveShader)' != ''">
    <EmbeddedResource Include="$(WaveShader)" LogicalName="Botamochi.PackWave.dxil" />
  </ItemGroup>
  <ItemGroup Condition="'$(NvencLibrary)' != ''">
    <None Include="$(NvencLibrary)" Link="BotamochiNvenc.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- GPU Compute Shader (DX12/HLSL C#インラインコンパイル) -->
    <PackageReference Include="ComputeSharp" Version="3.1.0" />
    <!-- ローレベルグラフィックス & オフスクリーンレンダリング -->
    <PackageReference Include="Silk.NET.Direct3D12" Version="2.22.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.22.0" />
    <!-- ロギング & 診断・テレメトリー -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0-preview.1.25080.5" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0-preview.1.25080.5" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- フォールバック用標準パッケージ参照 (net9/net8互換) -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" Condition="'$(TargetFramework)' != 'net10.0'" />
  </ItemGroup>
</Project>
